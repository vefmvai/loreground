# Пример .gitignore для агента, собранного по стандарту (§ 9.3, § 9.4).
# Скопируй в корень проекта агента под именем `.gitignore` и дополни своим.

# ── Личное: не уезжает никуда, даже если репозиторий станет публичным ──
knowledge/_personal/
*.private.md

# ── Слой пользователя (§ 9.4): обновление ядра его физически не видит ──
my/

# ── Сырьё: дословные материалы и стенограммы могут нести секреты ──
sources-raw/
raw/
_retro/

# ── Секреты: их дом не здесь (§ 1.1), но подстраховка не мешает ──
.env
.env.*
*.key
*.pem

# ── Служебное ──
.DS_Store
__pycache__/
