#!/usr/bin/env bash
# Точка входа валидатора в PATH, пока плагин включён.
# Сам валидатор лежит в standard/ — рядом со стандартом, как сказано в core.md § 10.
set -euo pipefail
SRC="${BASH_SOURCE[0]}"
# Разворачиваем цепочку симлинков: скрипт может быть слинкован в чужой bin/.
while [ -L "$SRC" ]; do
  TGT="$(readlink "$SRC")"
  case "$TGT" in /*) SRC="$TGT" ;; *) SRC="$(cd "$(dirname "$SRC")" && pwd)/$TGT" ;; esac
done
DIR="$(cd "$(dirname "$SRC")/.." && pwd)"
# Про отсутствие PyYAML валидатор говорит человеческим текстом с командой установки.
# Про отсутствие самого python3 до этой правки говорила оболочка: «exec: python3: not
# found», код 127. Разный вес одной и той же беды — «нечем проверить»; здесь ответ
# приводится к тому же виду, и код 2 означает «прогон не состоялся», как у валидатора.
if ! command -v python3 >/dev/null 2>&1; then
  echo "ОШИБКА: не найден python3 — прогон невозможен." >&2
  echo "    Валидатор и все четыре хука комплекта запускаются им." >&2
  echo "    Проверить: python3 --version. Поставить: https://www.python.org/downloads/" >&2
  echo "    Это не «база чистая» — проверка не выполнялась." >&2
  exit 2
fi
exec python3 "$DIR/standard/validate.py" "$@"
