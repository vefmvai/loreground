{
  "description": "Хуки комплекта. Старт сессии: исполнитель паспорта стартовой загрузки, сторож свежести кодекса и сторож расхождения версий. После записи: автопрогон валидатора базы. Все молчат, если в проекте нет метки сборки .loreground",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/startup-load.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-freshness.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/version-drift.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/validate-on-write.py\""
          }
        ]
      }
    ]
  }
}
